{
  "expo": {
    "name": "SiteVault",
    "slug": "sitevault",
    "version": "1.0.0",
    "scheme": "sitevault",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#141210",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.northline.sitevault",
      "userInterfaceStyle": "dark",
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": true
      }
    },
    "android": {
      "package": "com.northline.sitevault",
      "userInterfaceStyle": "dark",
      "adaptiveIcon": {
        "backgroundColor": "#141210",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#141210",
          "image": "./assets/icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#141210"
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": []
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "SiteVault uses your photo library to attach job site photos and documents.",
          "cameraPermission": "SiteVault uses your camera to capture job site photos for checklists, hazard assessments, and deficiencies."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
